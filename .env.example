# Landslide Early-Warning System (LEWS) - Environment Configuration
# SIH PS 26001

# Indian Meteorological Department API (Optional official key)
IMD_API_KEY=

# Map Providers (Optional, Leaflet uses OSM/Carto/Esri by default)
MAPBOX_TOKEN=

# NASA Earthdata (Optional advanced soil moisture)
NASA_EARTHDATA_TOKEN=

# Copernicus Data Space Ecosystem (Optional DEM access)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Notification / SMS Gateway (Optional)
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Application Server
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
LOG_LEVEL=INFO
APP_ENV=production
